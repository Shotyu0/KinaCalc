rules_version = '2';

// Kina Ledger access rules. Paste these into Firebase console > Firestore Database > Rules.
//
// People are added by the owner in the Firebase console: create a document in the `members`
// collection whose ID is the person's Google email address in lowercase, with a string field
// `role` set to "owner" (you) or "member" (everyone else). Nobody can add themselves.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberPath() {
      return /databases/$(database)/documents/members/$(request.auth.token.email);
    }
    function isMember() {
      return signedIn() && exists(memberPath());
    }
    function isOwner() {
      return isMember() && get(memberPath()).data.role == 'owner';
    }
    // Prices: zero up to a trillion Kina.
    function optNumber(d, key) {
      return !(key in d) || d[key] == null || (d[key] is number && d[key] >= 0 && d[key] < 1000000000000);
    }
    // Times are milliseconds since 1970, about 1.8 trillion today.
    function optTime(d, key) {
      return !(key in d) || d[key] == null || (d[key] is number && d[key] >= 0 && d[key] < 100000000000000);
    }
    function optBool(d, key) {
      return !(key in d) || d[key] is bool;
    }
    // A price entry: only the fields the page writes, with sane types and sizes.
    function validItem(d) {
      return d.keys().hasOnly(['name', 'price', 'vendor', 'gather', 'bound', 'unavailable', 'updatedAt', 'hist', 'example'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && optNumber(d, 'price') && optNumber(d, 'vendor') && optTime(d, 'updatedAt')
        && optBool(d, 'gather') && optBool(d, 'bound') && optBool(d, 'unavailable') && optBool(d, 'example')
        && (!('hist' in d) || (d.hist is list && d.hist.size() <= 200));
    }

    // The member list. Each person may check their own entry; only the console can change it.
    match /members/{email} {
      allow read: if signedIn() && request.auth.token.email == email;
      allow write: if false;
    }

    // Prices and price history: every member reads and updates them. Only the owner deletes items.
    match /items/{itemId} {
      allow read: if isMember();
      allow create, update: if isMember() && validItem(request.resource.data);
      allow delete: if isOwner();
    }

    // Recipe edits and shared settings: members read them, only the owner changes them.
    match /recipes/{recipeId} {
      allow read: if isMember();
      allow write: if isOwner();
    }
    match /config/{docId} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    // Each member's own crafting levels, the items they gather, their gathering and crafting
    // sessions and their minutes per craft, private to them.
    match /users/{uid} {
      allow read: if isMember() && request.auth.uid == uid;
      allow write: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['levels', 'gather', 'runs', 'crafts', 'craftMin'])
        && request.resource.data.levels is map
        && request.resource.data.levels.size() <= 20
        && (!('gather' in request.resource.data) || (request.resource.data.gather is list && request.resource.data.gather.size() <= 2000))
        && (!('runs' in request.resource.data) || (request.resource.data.runs is list && request.resource.data.runs.size() <= 300))
        && (!('crafts' in request.resource.data) || (request.resource.data.crafts is list && request.resource.data.crafts.size() <= 300))
        && (!('craftMin' in request.resource.data) || (request.resource.data.craftMin is number && request.resource.data.craftMin > 0 && request.resource.data.craftMin <= 10000));
    }

    // Each member's counts of the grade their tracked extractions opened at, per node, so everyone can
    // pool them: the grade a node opens at is the same for everyone. Members read all of them; each
    // writes only their own, and nothing but those counts.
    match /pool/{uid} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nodes', 'at'])
        && request.resource.data.nodes is map && request.resource.data.nodes.size() <= 300
        && optTime(request.resource.data, 'at');
    }

    // Problem reports from the live gathering tracker: a picture of the popup frames and what was read.
    // Members send them under their own address; only the owner reads or deletes them.
    match /reports/{id} {
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['by', 'at', 'version', 'reasons', 'note', 'ex', 'sheet'])
        && request.resource.data.by == request.auth.token.email
        && request.resource.data.sheet is string && request.resource.data.sheet.size() < 1000000
        && request.resource.data.note is string && request.resource.data.note.size() <= 1000
        && request.resource.data.ex is string && request.resource.data.ex.size() <= 4000
        && request.resource.data.reasons is string && request.resource.data.reasons.size() <= 300
        && request.resource.data.version is string && request.resource.data.version.size() <= 40
        && optTime(request.resource.data, 'at');
      allow read, delete: if isOwner();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
